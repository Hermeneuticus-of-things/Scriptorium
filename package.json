{
  "name": "scribner",
  "productName": "Scribner",
  "version": "0.10.11",
  "description": "Program de scris pentru cărți lungi: scrii pe bucăți, le aranjezi liber și primești cartea în Word, PDF sau EPUB.",
  "main": "electron/main.cjs",
  "private": true,
  "bin": {
    "scribner-mcp": "mcp/server.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build --outDir dist-web",
    "start": "vite build && electron .",
    "test": "vitest run",
    "mcp": "node mcp/server.mjs",
    "dist:win": "vite build && electron-builder --win dir portable --publish never",
    "test:e2e": "vite build && node tests/e2e/electron.e2e.cjs && node tests/e2e/flows.e2e.cjs",
    "dist:win:portable": "vite build && electron-builder --win portable --publish never",
    "dist:win:setup": "node installer/build-setup.cjs"
  },
  "build": {
    "appId": "ro.scribner.app",
    "asar": false,
    "files": [
      "dist/**",
      "electron/**",
      "lib/**",
      "mcp/**",
      "cli/**",
      "src/lib/**",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "dir",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "productName": "Scribner",
    "portable": {
      "artifactName": "Scribner-${version}-portabil.exe"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-typography": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "diff": "^9.0.0",
    "docx": "^9.14.0",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
